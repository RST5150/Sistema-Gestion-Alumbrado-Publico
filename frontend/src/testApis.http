// COLUMNAS
GET http://localhost:3000/api/columnas

POST http://localhost:3000/api/columnas HTTP/1.1
content-type: application/json

{
    "nroSerie": "abcd123495",
    "material": "Acero",
    "fechaAdquisicion": "2024-05-19",
    "fechaInstalacion": "2024-05-24",
    "fechaRemocion": "2025-01-19"
}

PATCH http://localhost:3000/api/columnas/10 HTTP/1.1
content-type: application/json

{
    "fechaRemocion": "2024-05-19"
}

POST http://localhost:3000/api/columnas/findMany HTTP/1.1
content-type: application/json

{
    "nroSerie": "abcd120470",
    "material": "Madera",
    "fechaAdquisicion": "2003-03-09",
    "fechaInstalacion": "2004-05-24",
    "ids": [2, 3]
}

